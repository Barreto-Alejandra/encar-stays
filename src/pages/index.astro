    <section class="py-20 bg-white border-t border-gray-100">
        <div class="reveal max-w-4xl mx-auto px-4 text-center">
            <h2 class="text-3xl font-bold mb-6 text-dark">Cerca de la acción, lejos del ruido...</h2>
