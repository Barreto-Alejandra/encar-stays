<Layout title="Alojamientos Independientes en Encarnación | Encar Stays">
  
  <nav class="fixed top-0 w-full z-50 bg-white/90 backdrop-blur-md border-b border-gray-100 transition-all">
    <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      <div class="flex justify-between items-center h-16">
        <div class="flex-shrink-0">
          <span class="font-bold text-xl text-dark tracking-tight">Encar Stays</span>
        </div>
        <div>
          <a href="https://walink.co/jqq1e0" class="bg-green-600 hover:bg-green-700 text-white px-5 py-2 rounded-full text-sm font-bold transition shadow-lg flex items-center gap-2">
            <span>WhatsApp</span>
          </a>
        </div>
      </div>
    </div>
  </nav>

<main>
    <section class="relative min-h-[90vh] flex items-center justify-center overflow-hidden py-20">
      
