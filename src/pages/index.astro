        alt="Mapa ilustrado de Encarnación"
      />
      
      <div class="relative z-20 px-4 w-full max-w-4xl mx-auto">
        
        <div class="reveal bg-white/75 backdrop-blur-sm border border-white/50 shadow-2xl rounded-3xl p-8 md:p-12 text-center">
          
