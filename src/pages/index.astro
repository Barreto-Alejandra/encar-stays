        src="/images/hero-ia.webp"
        srcset="/images/hero-ia-mobile.webp 1100w, /images/hero-ia.webp 2200w"
        sizes="100vw"
        width="2200"
        height="1200"
        fetchpriority="high"
        decoding="async"
